{
  "schema": "splatthis.compositor-fidelity/4",
  "what": "How faithfully a deployed compositor reproduces the SAME splat population that the internal reference renderer draws. Both renders take identical splats, so any difference is the emitter and its runtime, not the fit.",
  "why": "A consumer that supplies its own splats -- projecting 3D Gaussians through EWA rather than fitting a bitmap -- inherits only this term. It must not budget against source-fidelity numbers, which are dominated by fitting error it does not have.",
  "formats": {
    "svg": {
      "method": {
        "reference": "render_splats_numpy(compositing_space='srgb')",
        "deployed": "Playwright Chromium viewport-clipped PNG screenshot",
        "gradient_quality": "standard",
        "metric": "ssim_srgb, windowed",
        "emitted_by": "splatthis.svg_export.save_svg at the current default painter order"
      },
      "corpus_images": 21,
      "expectation": {
        "ssim_srgb_min": 0.8921,
        "ssim_srgb_p10": 0.9136,
        "ssim_srgb_median": 0.9303,
        "ssim_srgb_max": 0.9815,
        "content_gradient_correlation": -0.323,
        "content_dependence": "weak.",
        "summary": "gradient_quality='standard'. Default. Supersedes an earlier published figure of 0.754, which was measured from stored gate rasters emitted before the corrected painter order became the default -- i.e. an emitter the project no longer ships."
      }
    },
    "pixel-runtime": {
      "method": {
        "reference": "render_splats_numpy(compositing_space='linear')",
        "deployed": "Google Chrome canvas.toDataURL pixel buffer",
        "metric": "ssim_srgb, windowed"
      },
      "corpus_images": 21,
      "expectation": {
        "ssim_srgb_min": 0.9988,
        "ssim_srgb_p10": 0.9989,
        "ssim_srgb_median": 0.9993,
        "ssim_srgb_max": 0.9998,
        "content_gradient_correlation": 0.0,
        "content_dependence": "none measurable. The runtime evaluates the splat formula directly rather than approximating it, so it is a parity model of the reference renderer.",
        "summary": "Effectively lossless. Choose this over SVG when fidelity matters more than vector editability; the emitter costs ~0.001 SSIM instead of ~0.25."
      }
    },
    "css": {
      "method": {
        "reference": "render_splats_numpy(compositing_space='srgb')",
        "deployed": "Playwright Chromium capture of the scriptless CSS build",
        "metric": "ssim_srgb, windowed"
      },
      "corpus_images": 21,
      "expectation": {
        "ssim_srgb_min": 0.8944,
        "ssim_srgb_p10": 0.9154,
        "ssim_srgb_median": 0.9426,
        "ssim_srgb_max": 0.9925,
        "content_gradient_correlation": -0.722,
        "content_dependence": "weak, as for the other emitters.",
        "summary": "Best declarative target. Emits colour in linear sRGB and applies the Gaussian falloff as an alpha mask over a solid fill, sampling the exact opacity curve at nine stops, so colour and opacity are not interpolated together. Close to the pixel runtime and far ahead of SVG, which cannot express a mask."
      }
    },
    "svg-high": {
      "method": {
        "reference": "render_splats_numpy(compositing_space='srgb')",
        "deployed": "Playwright Chromium viewport-clipped PNG screenshot",
        "gradient_quality": "high",
        "metric": "ssim_srgb, windowed",
        "emitted_by": "splatthis.svg_export.save_svg at the current default painter order"
      },
      "corpus_images": 21,
      "expectation": {
        "ssim_srgb_min": 0.8991,
        "ssim_srgb_p10": 0.9247,
        "ssim_srgb_median": 0.9486,
        "ssim_srgb_max": 0.9877,
        "content_gradient_correlation": -0.293,
        "content_dependence": "weak.",
        "summary": "gradient_quality='high'. Raises the stop budget from a mean of 3.2 stops per splat to 8.3 and the opacity precision from 2 decimals to 4, for +0.018 median SSIM at 1.74x the bytes. "
      }
    }
  },
