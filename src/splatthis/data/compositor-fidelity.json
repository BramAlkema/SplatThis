{
  "schema": "splatthis.compositor-fidelity/3",
  "what": "How faithfully a deployed compositor reproduces the SAME splat population that the internal reference renderer draws. Both renders take identical splats, so any difference is the emitter and its runtime, not the fit.",
  "why": "A consumer that supplies its own splats -- projecting 3D Gaussians through EWA rather than fitting a bitmap -- inherits only this term. It must not budget against source-fidelity numbers, which are dominated by fitting error it does not have.",
  "formats": {
    "svg": {
      "method": {
        "reference": "render_splats_numpy(compositing_space='srgb')",
        "deployed": "Playwright Chromium viewport-clipped PNG screenshot",
        "recipe": "standard",
        "metric": "ssim_srgb, windowed"
      },
      "corpus_images": 21,
      "expectation": {
        "ssim_srgb_min": 0.5965,
        "ssim_srgb_p10": 0.6524,
        "ssim_srgb_median": 0.754,
        "ssim_srgb_max": 0.8991,
        "content_gradient_correlation": -0.47,
        "content_dependence": "weak. Compositor loss is broadly uniform; the strong content dependence in end-to-end fidelity (r=-0.84 vs source) is almost entirely the fitting stage.",
        "summary": "SVG radial gradients approximate a Gaussian. The approximation costs real fidelity."
      }
    },
    "pixel-runtime": {
      "method": {
        "reference": "render_splats_numpy(compositing_space='linear')",
        "deployed": "Google Chrome canvas.toDataURL pixel buffer",
        "metric": "ssim_srgb, windowed"
      },
      "corpus_images": 21,
      "expectation": {
        "ssim_srgb_min": 0.9988,
        "ssim_srgb_p10": 0.9989,
        "ssim_srgb_median": 0.9993,
        "ssim_srgb_max": 0.9998,
        "content_gradient_correlation": 0.0,
        "content_dependence": "none measurable. The runtime evaluates the splat formula directly rather than approximating it, so it is a parity model of the reference renderer.",
        "summary": "Effectively lossless. Choose this over SVG when fidelity matters more than vector editability; the emitter costs ~0.001 SSIM instead of ~0.25."
      }
    },
    "css": {
      "method": {
        "reference": "render_splats_numpy(compositing_space='srgb')",
        "deployed": "Playwright Chromium capture of the scriptless CSS build",
        "metric": "ssim_srgb, windowed"
      },
      "corpus_images": 21,
      "expectation": {
        "ssim_srgb_min": 0.5949,
        "ssim_srgb_p10": 0.651,
        "ssim_srgb_median": 0.7488,
        "ssim_srgb_max": 0.8976,
        "content_gradient_correlation": -0.509,
        "content_dependence": "weak, as for SVG. Compositor loss is broadly uniform across content.",
        "summary": "Indistinguishable from SVG (median 0.7488 vs 0.7540). Both approximate a Gaussian with a radial gradient and pay the same ~0.25 SSIM for it; choose between them on embedding constraints, not fidelity."
      }
    }
  },
